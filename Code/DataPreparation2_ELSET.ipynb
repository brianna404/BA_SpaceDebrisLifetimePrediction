    "import time\n",
    "import json\n",
    "import os\n",
    "from httpx import ReadTimeout\n",
    "from spacetrack import SpaceTrackClient\n",
    "\n",
    "# settings\n",
    "chunk_size = 32\n",
    "request_delay = 5\n",
    "request_limit = 300\n",
    "limit_delay = 1200\n",
    "output_file = '../Data/AllEpochsLFS.csv'\n",
    "\n",
    "# start variables\n",
    "index = 22812\n",
    "total_objects = len(norad_ids)\n",
    "consecutive_timeouts = 0\n",
    "consecutive_successful = 0\n",
    "request_count = 1\n",
    "\n",
    "# main loop\n",
    "while index < total_objects:\n",
    "    # Check if the API request limit has been reached\n",
    "    if request_count >= request_limit:\n",
    "        print(f\"Reached {request_count} API requests. Waiting for {limit_delay} seconds.\")\n",
    "        time.sleep(limit_delay)\n",
    "        request_count = 0\n",
    "\n",
    "    # query start\n",
    "    current_chunk = norad_ids[index:index + chunk_size] \n",
    "    api_url = f\"https://www.space-track.org/basicspacedata/query/class/gp_history/NORAD_CAT_ID/{','.join(current_chunk[\"NORAD_CAT_ID\"].astype(str))}/format/json\"\n",
    "    print(f\"\\nRequest {request_count}: Querying {len(current_chunk)} objects from index {index} to {index+len(current_chunk)-1}...\")\n",
    "    print(f\"API URL: {api_url}\")\n",
    "\n",
    "\n",
    "    # try fetching data for chunk\n",
    "    try:\n",
    "        request_count += 1\n",
    "        time.sleep(request_delay)\n",
    "        omm_data = st.gp_history(norad_cat_id=','.join(current_chunk[\"NORAD_CAT_ID\"].astype(str)), format='json')\n",
    "        omm_data_json = json.loads(omm_data)\n",
    "        # check if data was returned\n",
    "        if not omm_data_json:\n",
    "            print(\"No data returned for this chunk. Skipping to the next chunk.\")\n",
    "            index += chunk_size\n",
    "            consecutive_timeouts = 0\n",
    "            consecutive_successful += 1\n",
    "            continue\n",
    "        omm_data_epochs = [{'NORAD_CAT_ID': entry['NORAD_CAT_ID'], 'EPOCH': entry['EPOCH']} for entry in omm_data_json] # extract only ID and Epoch to save RAM\n",
    "    # catch exceptions\n",
    "    except ReadTimeout:\n",
    "        consecutive_timeouts += 1\n",
    "        consecutive_successful = 0\n",
    "        print(f\"Timeout error ({consecutive_timeouts})\")\n",
    "        if consecutive_timeouts >= 2 and chunk_size > 1: # halve chunk size if api response is too large\n",
    "            new_chunk_size = chunk_size // 2\n",
    "            print(f\"Two consecutive timeouts. Reducing chunk size from {chunk_size} to {new_chunk_size}.\")\n",
    "            chunk_size = new_chunk_size\n",
    "            consecutive_timeouts = 0\n",
    "        continue\n",
    "    except Exception as e:\n",
    "        print(f\"Error: {e}\")\n",
    "        print(\"Skipping to the next chunk.\")\n",
    "        index += chunk_size\n",
    "        consecutive_timeouts = 0\n",
    "        consecutive_successful = 0\n",
    "        continue\n",
    "\n",
    "    consecutive_timeouts = 0\n",
    "    consecutive_successful += 1\n",
    "\n",
    "    df_chunk = pd.DataFrame(omm_data_epochs)\n",
    "\n",
    "    # log results\n",
    "    num_ids_with_omm = df_chunk['NORAD_CAT_ID'].nunique()\n",
    "    total_omms = len(df_chunk)\n",
    "    print(f\"Chunk {index // chunk_size}: Requested {len(current_chunk)} objects, {num_ids_with_omm} returned at least one OMM, {total_omms} OMMs in total retrieved.\")\n",
    "\n",
    "    df_chunk.to_csv(output_file, mode='a', index=False, header=not os.path.exists(output_file))\n",
    "    index += chunk_size\n",
    "\n",
    "    # double chunk size every 5 iterations (after 15 iterations (of 500) since 1000 would be a too long url) to see if bigger chunks are possible\n",
    "    if consecutive_successful % 5 == 0:\n",
    "        chunk_size = chunk_size * 2\n",
    "        print(f\"Five successful iterations passed. Doubling chunk size from {chunk_size // 2} to {chunk_size}.\")\n"
   ]
  },
