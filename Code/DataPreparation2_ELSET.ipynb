   "source": [
    "# Reauthenticate with Space-Track.org to avoid having to run first cell again\n",
    "\n",
    "# Space-Track.org API authentication \n",
    "from spacetrack import SpaceTrackClient\n",
    "import pandas as pd\n",
    "\n",
    "# read Space-Track.org credentials from external file (username in line 1, password in line 2)\n",
    "with open('../SpaceTrackCredentials.txt', 'r') as file:\n",
    "    credentials = file.read().splitlines()\n",
    "\n",
    "username = credentials[0]\n",
    "password = credentials[1]\n",
    "\n",
    "# create a SpaceTrackClient instance\n",
    "st = SpaceTrackClient(username, password) \n",
    "\n",
    "try:\n",
    "    # Try fetching a single SATCAT entry to verify authentication\n",
    "    test_data = st.gp(limit=1, format='json')\n",
    "    print(\"Successfully authenticated with Space-Track.org!\")\n",
    "except Exception as e:\n",
    "    print(f\"Failed to authenticate with Space-Track.org: {e}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 151,
